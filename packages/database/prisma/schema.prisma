// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  USER
  ADMIN
}

enum CampaignStatus {
  DRAFT
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
  CLOSED
}

enum DisasterType {
  FLOOD
  EARTHQUAKE
  CYCLONE
  WILDFIRE
  TSUNAMI
  LANDSLIDE
  PANDEMIC
  DROUGHT
  VOLCANO
  HURRICANE
  TORNADO
  OTHER
}

enum DonationStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum AiVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  FLAGGED
  REVIEW_REQUIRED
}

enum TransactionType {
  DONATION
  REFUND
  WITHDRAWAL
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ============================================================================
// USER MODEL
// ============================================================================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  username          String?   @unique
  passwordHash      String
  firstName         String?
  lastName          String?
  avatar            String?
  role              UserRole  @default(USER)
  walletAddress     String?
  isEmailVerified   Boolean   @default(false)
  emailVerifyToken  String?
  resetPasswordToken String?
  resetPasswordExpiry DateTime?
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  donations         Donation[]
  notifications     Notification[]
  auditLogs         AuditLog[]

  @@map("users")
}

// ============================================================================
// CAMPAIGN MODEL
// ============================================================================

model Campaign {
  id                   String          @id @default(cuid())
  name                 String
  slug                 String          @unique
  description          String          @db.Text
  shortDescription     String?
  disasterType         DisasterType
  country              String
  state                String?
  city                 String?
  latitude             Float?
  longitude            Float?
  bannerImage          String
  galleryImages        String[]
  goalAmount           Float
  raisedAmount         Float           @default(0)
  donorsCount          Int             @default(0)
  beneficiaryWallet    String
  status               CampaignStatus  @default(DRAFT)
  isPublished          Boolean         @default(false)
  isFeatured           Boolean         @default(false)
  priority             Int             @default(0)
  aiCategory           String?
  expiryDate           DateTime
  publishedAt          DateTime?
  completedAt          DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  // AI Fields
  aiVerified           Boolean         @default(false)
  aiVerificationStatus AiVerificationStatus @default(PENDING)
  aiRiskScore          Float?
  aiUrgencyScore       Float?
  aiEstimatedFunding   Float?
  aiSummary            String?         @db.Text
  aiFlags              String[]

  // Relations
  donations            Donation[]
  aiAnalysis           AiAnalysis[]
  transactions         Transaction[]

  @@map("campaigns")
}

// ============================================================================
// DONATION MODEL
// ============================================================================

model Donation {
  id                   String          @id @default(cuid())
  campaignId           String
  donorId              String?
  donorWallet          String
  donorEmail           String?
  amount               Float
  amountInMicroAlgo    Int
  currency             String          @default("ALGO")
  status               DonationStatus  @default(PENDING)

  // Algorand Blockchain Fields
  algorandTxId         String?         @unique
  blockNumber          Int?
  blockRound           Int?
  confirmationRound    Int?
  confirmationStatus   String?
  explorerUrl          String?

  // x402 Fields
  x402PaymentRequest   String?         @db.Text
  x402Receipt          String?         @db.Text
  x402ReceiptHash      String?
  x402Verified         Boolean         @default(false)

  // Metadata
  ipAddress            String?
  userAgent            String?
  message              String?
  isAnonymous          Boolean         @default(false)

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  // Relations
  campaign             Campaign        @relation(fields: [campaignId], references: [id])
  donor                User?           @relation(fields: [donorId], references: [id])
  transaction          Transaction?

  @@map("donations")
}

// ============================================================================
// TRANSACTION MODEL
// ============================================================================

model Transaction {
  id                String            @id @default(cuid())
  donationId        String            @unique
  campaignId        String
  type              TransactionType   @default(DONATION)
  amount            Float
  currency          String            @default("ALGO")
  algorandTxId      String?
  fromAddress       String
  toAddress         String
  fee               Float?
  blockRound        Int?
  status            String
  explorerUrl       String?
  rawTransaction    Json?
  confirmedAt       DateTime?
  createdAt         DateTime          @default(now())

  // Relations
  donation          Donation          @relation(fields: [donationId], references: [id])
  campaign          Campaign          @relation(fields: [campaignId], references: [id])

  @@map("transactions")
}

// ============================================================================
// AI ANALYSIS MODEL
// ============================================================================

model AiAnalysis {
  id                    String               @id @default(cuid())
  campaignId            String
  verificationStatus    AiVerificationStatus @default(PENDING)
  riskScore             Float?
  urgencyScore          Float?
  estimatedFunding      Float?
  duplicateFlag         Boolean              @default(false)
  fraudFlag             Boolean              @default(false)
  duplicateCampaignId   String?
  summary               String?              @db.Text
  imageAnalysis         String?              @db.Text
  textAnalysis          String?              @db.Text
  flags                 String[]
  recommendations       String[]
  confidence            Float?
  modelUsed             String?
  rawResponse           Json?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  // Relations
  campaign              Campaign             @relation(fields: [campaignId], references: [id])

  @@map("ai_analyses")
}

// ============================================================================
// AUDIT LOG MODEL
// ============================================================================

model AuditLog {
  id          String    @id @default(cuid())
  userId      String?
  action      String
  resource    String
  resourceId  String?
  details     Json?
  ipAddress   String?
  userAgent   String?
  success     Boolean   @default(true)
  createdAt   DateTime  @default(now())

  // Relations
  user        User?     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ============================================================================
// NOTIFICATION MODEL
// ============================================================================

model Notification {
  id          String    @id @default(cuid())
  userId      String
  title       String
  message     String    @db.Text
  type        String    @default("info")
  read        Boolean   @default(false)
  link        String?
  metadata    Json?
  createdAt   DateTime  @default(now())

  // Relations
  user        User      @relation(fields: [userId], references: [id])

  @@map("notifications")
}

// ============================================================================
// AI ALERT MODEL
// ============================================================================

model AiAlert {
  id          String          @id @default(cuid())
  campaignId  String?
  donationId  String?
  severity    AlertSeverity
  type        String
  title       String
  description String          @db.Text
  resolved    Boolean         @default(false)
  resolvedBy  String?
  resolvedAt  DateTime?
  metadata    Json?
  createdAt   DateTime        @default(now())

  @@map("ai_alerts")
}

// ============================================================================
// ADMIN SETTINGS MODEL
// ============================================================================

model AdminSettings {
  id                  String    @id @default(cuid())
  twoFactorEnabled    Boolean   @default(false)
  maintenanceMode     Boolean   @default(false)
  donationsEnabled    Boolean   @default(true)
  registrationEnabled Boolean   @default(true)
  geminiApiKey        String?
  walletConnectProjectId String?
  x402Config          Json?
  emailConfig         Json?
  updatedAt           DateTime  @updatedAt

  @@map("admin_settings")
}
